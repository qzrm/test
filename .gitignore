# 依赖与构建产物
node_modules/
dist/
build/
*.log

# 本地环境变量/密钥
.env
.env.local

# 编辑器/系统临时文件
.DS_Store
Thumbs.db
.idea/

# 运行产物（C 程序运行生成的临时输出，不纳入版本管理）
t99_out.txt
t99_result.txt
t99_stdout.txt
*.exe

# 保留 VS Code / CodeBuddy 运行配置（团队共享 F5 环境，需纳入版本管理）
!.vscode/
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/*.json
# 但忽略本地缓存
.vscode/*.log
.vscode/ipch/

# 保留 CodeBuddy 共享自动化配置（团队共享，需纳入版本管理）
!.codebuddy/
!.codebuddy/automations/
!.codebuddy/automations/*.toml
